# Copy to /etc/systemd/system/ and enable the timer:
#   sudo systemctl enable --now caddy-tui-check.timer
# A non-zero exit marks the unit as failed (see OnFailure= to chain a notifier).
[Unit]
Description=Check the Caddy container with caddy-tui

[Service]
Type=oneshot
# Exit codes: 0 ok, 1 warnings, 2 problems, 3 could not run.
ExecStart=/usr/bin/caddy-tui --check --quiet --lang en
# Treat warnings (1) as success; only problems (2) and failures (3) fail the unit:
SuccessExitStatus=1
