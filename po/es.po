msgid "running"
msgstr "en marcha"

msgid "stopped"
msgstr "parado"

msgid "created"
msgstr "creado"

msgid "paused"
msgstr "en pausa"

msgid "restarting"
msgstr "reiniciando"

msgid "dead"
msgstr "muerto"

msgid "not found"
msgstr "no existe"

msgid "Docker unavailable"
msgstr "docker no disponible"

msgid "Add service (wizard)"
msgstr "Añadir servicio (asistente)"

msgid "Manage services"
msgstr "Gestionar servicios"

msgid "Traffic monitor"
msgstr "Monitor de tráfico"

msgid "Diagnostics & repair"
msgstr "Diagnóstico y reparación"

msgid "HTTPS certificates"
msgstr "Certificados HTTPS"

msgid "Edit Caddyfile"
msgstr "Editar Caddyfile"

msgid "Validate configuration"
msgstr "Validar configuración"

msgid "Reload (no downtime)"
msgstr "Recargar (sin cortes)"

msgid "Start / apply"
msgstr "Arrancar / aplicar"

msgid "Stop"
msgstr "Parar"

msgid "Restart"
msgstr "Reiniciar"

msgid "View logs"
msgstr "Ver logs"

msgid "Format Caddyfile"
msgstr "Formatear Caddyfile"

msgid "View Caddyfile"
msgstr "Ver Caddyfile"

msgid "Create backup (Caddyfile+.env)"
msgstr "Crear backup (Caddyfile+.env)"

msgid "Restore backup"
msgstr "Restaurar backup"

msgid "Edit .env"
msgstr "Editar .env"

msgid "Quit"
msgstr "Salir"

#, python-brace-format
msgid "Command not found: {cmd}"
msgstr "No se encuentra el comando: {cmd}"

#, python-brace-format
msgid "Timed out running: {cmd}"
msgstr "Tiempo agotado ejecutando: {cmd}"

msgid "No Caddy container found. Specify one with --container NAME."
msgstr ""
"No encuentro ningún contenedor de Caddy. Indícalo con --container NOMBRE."

msgid "There are several Caddy containers; choose one with --container NAME."
msgstr "Hay varios contenedores de Caddy; elige uno con --container NOMBRE."

msgid "There are several Caddy containers:"
msgstr "Hay varios contenedores de Caddy:"

msgid "Choose a number: "
msgstr "Elige número: "

msgid "Invalid selection. Use --container NAME."
msgstr "Selección no válida. Usa --container NOMBRE."

#, python-brace-format
msgid "Container '{name}' does not exist."
msgstr "No existe el contenedor '{name}'."

#, python-brace-format
msgid ""
"Caddyfile not found at {path}.\n"
"If it belongs to another user, run with sudo; or give its path with --"
"caddyfile."
msgstr ""
"No encuentro el Caddyfile en {path}.\n"
"Si pertenece a otro usuario, ejecuta con sudo; o indica la ruta con --"
"caddyfile."

#, python-brace-format
msgid "No read/write permission on {path}. Run with sudo or as another user."
msgstr ""
"Sin permisos de lectura/escritura sobre {path}. Ejecuta con sudo o con otro "
"usuario."

msgid ""
"This action needs docker compose (the container was not created with it)."
msgstr "Esta acción necesita docker compose (el contenedor no se creó con él)."

#, python-brace-format
msgid "Could not prepare validation: {err}"
msgstr "No se pudo preparar la validación: {err}"

msgid "(custom block)"
msgstr "(bloque a medida)"

#, python-brace-format
msgid "Service '{service}' not found in {file}"
msgstr "No se encuentra el servicio '{service}' en {file}"

#, python-brace-format
msgid "in service '{service}':"
msgstr "en el servicio '{service}':"

msgid "and at the end of the file:"
msgstr "y al final del fichero:"

msgid "Could not read the certificate storage of the container."
msgstr "No se pudo leer el almacén de certificados del contenedor."

#, python-brace-format
msgid "{names} · internal CA (local, renewed automatically)"
msgstr "{names} · CA interna (local, se renueva sola)"

msgid ""
"Caddy renews about 30 days before expiry. If it has not, check the ACME "
"errors below or the logs [g]."
msgstr ""
"Caddy renueva unos 30 días antes de que caduque. Si no lo ha hecho, revisa "
"los errores ACME de abajo o los logs [g]."

#, python-brace-format
msgid "{names} · {issuer} · EXPIRED on {date}"
msgstr "{names} · {issuer} · CADUCADO el {date}"

#, python-brace-format
msgid "{names} · {issuer} · about to expire: {date} ({days} days left)"
msgstr "{names} · {issuer} · a punto de caducar: {date} (quedan {days} días)"

#, python-brace-format
msgid ""
"{names} · {issuer} · renewal pending: valid until {date} ({days} days left)"
msgstr ""
"{names} · {issuer} · renovación pendiente: válido hasta {date} (quedan "
"{days} días)"

#, python-brace-format
msgid "{names} · {issuer} · valid until {date} ({days} days left)"
msgstr "{names} · {issuer} · válido hasta {date} (quedan {days} días)"

#, python-brace-format
msgid "Let's Encrypt/ACME is failing for {domain}"
msgstr "Let's Encrypt/ACME está fallando para {domain}"

msgid ""
"Typical causes: DNS not pointing here, ports 80/443 closed, or rate limits "
"(wait an hour)."
msgstr ""
"Causas típicas: el DNS no apunta aquí, puertos 80/443 cerrados o límites de "
"frecuencia (espera una hora)."

#, python-brace-format
msgid "No certificate yet for {domain}"
msgstr "Aún no hay certificado para {domain}"

msgid ""
"Caddy requests it on the first HTTPS request. Check that the DNS points to "
"this server and that ports 80 and 443 are reachable from the Internet."
msgstr ""
"Caddy lo solicita en la primera petición HTTPS. Comprueba que el DNS apunta "
"a este servidor y que los puertos 80 y 443 son accesibles desde Internet."

msgid "No certificates stored yet"
msgstr "Todavía no hay certificados guardados"

#, python-brace-format
msgid "Result: {problems} problem(s), {warns} warning(s)."
msgstr "Resultado: {problems} problema(s), {warns} aviso(s)."

msgid "All good."
msgstr "Todo correcto."

msgid "Docker is not responding"
msgstr "Docker no responde"

msgid ""
"Fix: start Docker (systemctl start docker) and check that your user can use "
"it."
msgstr ""
"Solución: arranca Docker (systemctl start docker) y comprueba que tu usuario "
"puede usarlo."

#, python-brace-format
msgid "Docker available (v{version})"
msgstr "Docker disponible (v{version})"

#, python-brace-format
msgid ""
"Variable {name} in the Caddyfile is not defined (neither in the container "
"nor in .env)"
msgstr ""
"La variable {name} del Caddyfile no está definida (ni en el contenedor ni "
"en .env)"

#, python-brace-format
msgid "Fix: define {name}=... in .env with [n] and apply it with [s]."
msgstr "Solución: define {name}=... en .env con [n] y aplícalo con [s]."

#, python-brace-format
msgid "Caddyfile variables defined ({names})"
msgstr "Variables del Caddyfile definidas ({names})"

msgid "The Caddyfile is valid"
msgstr "El Caddyfile es válido"

msgid ""
"Fix: edit it with [e] (the TUI will not let you save something invalid)."
msgstr "Solución: edítalo con [e] (la TUI no te dejará guardar algo inválido)."

msgid ""
"Fix: 'import name' needs a snippet '(name) { ... }' defined at the top of "
"the Caddyfile, or a file with that name next to it."
msgstr ""
"Solución: 'import nombre' necesita un snippet '(nombre) { ... }' definido al "
"principio del Caddyfile, o un fichero con ese nombre junto a él."

msgid "The Caddyfile is NOT valid"
msgstr "El Caddyfile NO es válido"

#, python-brace-format
msgid "Container {name} is not running (state: {state})"
msgstr "El contenedor {name} no está en marcha (estado: {state})"

msgid "Fix: start it with [s]."
msgstr "Solución: arráncalo con [s]."

#, python-brace-format
msgid "Container {name} is running"
msgstr "Contenedor {name} en marcha"

msgid "The container uses a DIFFERENT Caddyfile than the one on disk"
msgstr "El contenedor usa un Caddyfile DISTINTO al del disco"

msgid ""
"Typical cause: an editor replaced the file and Docker still mounts the old "
"one."
msgstr ""
"Causa típica: un editor sustituyó el fichero y Docker sigue montando el "
"antiguo."

msgid "Fix: recreate the container. Until then your changes are not applied!"
msgstr ""
"Solución: recrear el contenedor. ¡Hasta entonces los cambios no se aplican!"

msgid "The container sees the same Caddyfile as the disk"
msgstr "El contenedor ve el mismo Caddyfile que el disco"

#, python-brace-format
msgid "Caddyfile ports not published by the container: {ports}"
msgstr "Puertos del Caddyfile sin publicar en el contenedor: {ports}"

msgid "Those sites will not be reachable from outside."
msgstr "Desde fuera no se podrá acceder a esos sitios."

#, python-brace-format
msgid "Fix: add them to 'ports' of service '{service}' in the docker compose."
msgstr ""
"Solución: añadirlos a 'ports' del servicio '{service}' en el docker compose."

#, python-brace-format
msgid "Site ports published ({ports})"
msgstr "Puertos de los sitios publicados ({ports})"

#, python-brace-format
msgid "Ports {ports} not published"
msgstr "Puertos {ports} sin publicar"

msgid ""
"They are needed for Let's Encrypt to issue certificates (HTTP-01 challenge) "
"and for the HTTP→HTTPS redirect."
msgstr ""
"Hacen falta para que Let's Encrypt emita certificados (reto HTTP-01) y para "
"la redirección HTTP→HTTPS."

msgid ""
"Ignore this if you use your own certificates, DNS-01 or only a local network."
msgstr "Ignóralo si usas certificados propios, DNS-01 o solo red local."

#, python-brace-format
msgid "Upstream {host}:{port} responds"
msgstr "El destino {host}:{port} responde"

msgid "host.docker.internal is not configured in the container"
msgstr "host.docker.internal no está configurado en el contenedor"

msgid "Fix: add extra_hosts 'host.docker.internal:host-gateway'."
msgstr "Solución: añadir extra_hosts 'host.docker.internal:host-gateway'."

#, python-brace-format
msgid "Fix: connect Caddy to the network of '{host}'."
msgstr "Solución: conectar Caddy a la red de '{host}'."

#, python-brace-format
msgid "'{host}' is on Docker network: {nets}"
msgstr "'{host}' está en la red Docker: {nets}"

#, python-brace-format
msgid "Fix: add that network to '{service}' as external in the docker compose."
msgstr ""
"Solución: añadir esa red a '{service}' como externa en el docker compose."

msgid "I found no running container with that name: is it stopped?"
msgstr ""
"No he encontrado ningún contenedor en marcha con ese nombre: ¿está parado?"

#, python-brace-format
msgid "Caddy cannot resolve upstream '{host}' (different network)"
msgstr "Caddy no resuelve el destino '{host}' (red distinta)"

#, python-brace-format
msgid "{host}:{port} refuses the connection"
msgstr "{host}:{port} rechaza la conexión"

msgid "The service is not listening: is it stopped, or on another port?"
msgstr "El servicio no está escuchando: ¿está parado o es otro puerto?"

#, python-brace-format
msgid "{host}:{port} does not respond (timeout)"
msgstr "{host}:{port} no responde (timeout)"

msgid "Check that the service is running and the firewall."
msgstr "Revisa que el servicio esté arrancado y el cortafuegos."

#, python-brace-format
msgid "{count} errors in the logs of the last 10 min"
msgstr "{count} errores en los logs de los últimos 10 min"

msgid "No errors in the logs of the last 10 min"
msgstr "Sin errores en los logs de los últimos 10 min"

#, python-brace-format
msgid "HTTPS certificates valid ({n})"
msgstr "Certificados HTTPS válidos ({n})"

msgid ""
"Telegram is not configured (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID). Run: "
"sudo caddy-tui --setup-alerts"
msgstr ""
"Telegram no está configurado (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID). "
"Ejecuta: sudo caddy-tui --setup-alerts"

#, python-brace-format
msgid "{host}: Caddy is OK again."
msgstr "{host}: Caddy vuelve a estar bien."

msgid "Caddy check failed."
msgstr "La comprobación de Caddy ha fallado."

#, python-brace-format
msgid "Could not send the Telegram message: {error}"
msgstr "No se pudo enviar el mensaje de Telegram: {error}"

msgid " [Y/n] "
msgstr " [S/n] "

msgid " [y/N] "
msgstr " [s/N] "

msgid "Setting up alerts needs root. Run it with sudo."
msgstr "Configurar las alertas necesita root. Ejecútalo con sudo."

msgid "== caddy-tui alerts setup =="
msgstr "== Configuración de alertas de caddy-tui =="

#, python-brace-format
msgid "Caddy container: {name}"
msgstr "Contenedor de Caddy: {name}"

msgid "Telegram bot token (create one with @BotFather): "
msgstr "Token del bot de Telegram (créalo con @BotFather): "

#, python-brace-format
msgid "The bot token is not valid: {error}"
msgstr "El token del bot no es válido: {error}"

msgid "No valid Telegram bot token."
msgstr "No hay un token de bot de Telegram válido."

#, python-brace-format
msgid "Bot: @{username}"
msgstr "Bot: @{username}"

msgid "Telegram chat id (empty = detect it)"
msgstr "Id del chat de Telegram (vacío = detectarlo)"

#, python-brace-format
msgid "Send any message to @{username} on Telegram now, then press Enter."
msgstr "Envía ahora cualquier mensaje a @{username} en Telegram y pulsa Enter."

#, python-brace-format
msgid "Could not read the bot updates: {error}"
msgstr "No se pudieron leer los mensajes del bot: {error}"

msgid ""
"The bot has not received any message yet. Write to it and run the setup "
"again."
msgstr ""
"El bot aún no ha recibido ningún mensaje. Escríbele y vuelve a ejecutar la "
"configuración."

#, python-brace-format
msgid "Found chat: {title} ({id})"
msgstr "Chat encontrado: {title} ({id})"

msgid "Send the alerts to this chat?"
msgstr "¿Enviar las alertas a este chat?"

msgid "Cancelled."
msgstr "Cancelado."

msgid "Check interval (e.g. 30m, 1h, 6h)"
msgstr "Intervalo de comprobación (p. ej. 30m, 1h, 6h)"

msgid "Invalid interval. Use between 5 minutes and 24 hours, e.g. 30m, 1h, 6h."
msgstr ""
"Intervalo no válido. Usa entre 5 minutos y 24 horas, p. ej. 30m, 1h, 6h."

msgid "Also notify on warnings (not only on problems)?"
msgstr "¿Avisar también de los avisos (no solo de los problemas)?"

#, python-brace-format
msgid "Saved {path} (mode 600)."
msgstr "Guardado {path} (modo 600)."

#, python-brace-format
msgid "systemctl failed: {error}"
msgstr "systemctl ha fallado: {error}"

#, python-brace-format
msgid ""
"systemd timer enabled: every {minutes} min. See it with: systemctl list-"
"timers {unit}.timer"
msgstr ""
"Timer de systemd activado: cada {minutes} min. Compruébalo con: systemctl "
"list-timers {unit}.timer"

#, python-brace-format
msgid "No systemd found: cron job written to {path} (every {minutes} min)."
msgstr "No hay systemd: tarea de cron escrita en {path} (cada {minutes} min)."

#, python-brace-format
msgid ""
"{host}: caddy-tui alerts are set up. You will be notified here when the "
"Caddy check finds problems."
msgstr ""
"{host}: las alertas de caddy-tui están configuradas. Aquí recibirás un aviso "
"cuando la comprobación de Caddy encuentre problemas."

msgid "Test message sent to Telegram."
msgstr "Mensaje de prueba enviado a Telegram."

msgid "First check:"
msgstr "Primera comprobación:"

msgid "Removing alerts needs root. Run it with sudo."
msgstr "Quitar las alertas necesita root. Ejecútalo con sudo."

#, python-brace-format
msgid "Removed: {files}"
msgstr "Eliminado: {files}"

msgid "There was nothing to remove."
msgstr "No había nada que eliminar."

#, python-brace-format
msgid "Also delete the saved Telegram settings ({path})?"
msgstr "¿Borrar también la configuración de Telegram guardada ({path})?"

#, python-brace-format
msgid "Deleted {path}."
msgstr "Borrado {path}."

msgid "Welcome. Press a key from the menu."
msgstr "Bienvenido. Pulsa una tecla del menú."

msgid "Output"
msgstr "Salida"

msgid "(no output)"
msgstr "(sin salida)"

msgid "Terminal too small (min. 50x12)"
msgstr "Terminal demasiado pequeña (mín. 50x12)"

msgid "Container: "
msgstr "Contenedor: "

#, python-brace-format
msgid "  (up {time})"
msgstr "  (activo {time})"

msgid "↑/↓ PgUp/PgDn scroll output"
msgstr "↑/↓ PgUp/PgDn desplazar salida"

msgid "↑/↓ choose · Enter accept · Esc cancel"
msgstr "↑/↓ elegir · Enter aceptar · Esc cancelar"

msgid "Working..."
msgstr "Trabajando..."

msgid "Validating Caddyfile..."
msgstr "Validando Caddyfile..."

msgid "Validation: ✔ OK"
msgstr "Validación: ✔ CORRECTA"

msgid "Validation: ✘ ERRORS"
msgstr "Validación: ✘ ERRORES"

msgid "Reload"
msgstr "Recargar"

msgid "The container is not running. Use [s] to start it."
msgstr "El contenedor no está en marcha. Usa [s] para arrancarlo."

msgid "Reloading configuration..."
msgstr "Recargando configuración..."

msgid "Configuration reloaded without downtime."
msgstr "Configuración recargada sin cortes."

msgid "Reload: OK"
msgstr "Recargar: OK"

msgid "Reload: ERROR"
msgstr "Recargar: ERROR"

msgid "(done)"
msgstr "(hecho)"

msgid "Reading logs..."
msgstr "Leyendo logs..."

#, python-brace-format
msgid "Logs of {name} (last 200 lines)"
msgstr "Logs de {name} (últimas 200 líneas)"

msgid "Formatting..."
msgstr "Formateando..."

msgid "Format: ERROR"
msgstr "Formatear: ERROR"

msgid "Format"
msgstr "Formatear"

msgid "The Caddyfile is already correctly formatted."
msgstr "El Caddyfile ya está correctamente formateado."

msgid "Caddyfile reformatted (backup in .caddy-backups/)."
msgstr "Caddyfile reformateado (copia en .caddy-backups/)."

msgid "Edit"
msgstr "Editar"

msgid "No changes."
msgstr "Sin cambios."

msgid "Validating changes..."
msgstr "Validando cambios..."

msgid "The configuration is NOT valid"
msgstr "La configuración NO es válida"

msgid "Edit again? (No = discard changes)"
msgstr "¿Volver a editar? (No = descartar cambios)"

msgid "Changes discarded. The Caddyfile was not modified."
msgstr "Cambios descartados. El Caddyfile no se ha modificado."

#, python-brace-format
msgid ""
"Caddyfile saved and validated.\n"
"Previous copy: {path}"
msgstr ""
"Caddyfile guardado y validado.\n"
"Copia anterior: {path}"

msgid "Reload Caddy now?"
msgstr "¿Recargar Caddy ahora?"

msgid "Backup"
msgstr "Backup"

#, python-brace-format
msgid ""
"Backup created: {path}\n"
"Contains: {files}"
msgstr ""
"Backup creado: {path}\n"
"Contiene: {files}"

msgid "Restore"
msgstr "Restaurar"

msgid ""
"No backups yet. Create one with [k] (copies are also made when editing)."
msgstr ""
"No hay backups todavía. Crea uno con [k] (también se crean copias al editar)."

msgid "(Caddyfile only)"
msgstr "(solo Caddyfile)"

msgid "Choose the backup to restore"
msgstr "Elige el backup a restaurar"

msgid "Validating backup..."
msgstr "Validando backup..."

msgid "The backup's Caddyfile is not valid; not restoring"
msgstr "El Caddyfile del backup no es válido; no se restaura"

msgid "Caddyfile and .env"
msgstr "Caddyfile y .env"

#, python-brace-format
msgid "Restore {what}? The current state will be backed up first."
msgstr "¿Restaurar {what}? Se hará backup del estado actual antes."

msgid "Use [l] to reload the Caddyfile or [s] to apply .env changes."
msgstr "Usa [l] para recargar el Caddyfile o [s] para aplicar cambios de .env."

msgid "Use [l] to reload the Caddyfile."
msgstr "Usa [l] para recargar el Caddyfile."

#, python-brace-format
msgid "Restored {what} from {file}."
msgstr "Restaurado {what} desde {file}."

msgid "yes"
msgstr "sí"

msgid "no"
msgstr "no"

msgid "[ Accept ]"
msgstr "[ Aceptar ]"

msgid "[ Cancel ]"
msgstr "[ Cancelar ]"

msgid "Tab/↑↓ move · Space toggle · Ctrl+U clear field · Esc cancel"
msgstr ""
"Tab/↑↓ moverse · Espacio marca/desmarca · Ctrl+U borra campo · Esc cancela"

msgid "Service domain"
msgstr "Dominio del servicio"

msgid "E.g. app.mydomain.com (its DNS must point to this server)"
msgstr "Ej.: app.midominio.com (debe apuntar por DNS a este servidor)"

msgid "Upstream (host:port)"
msgstr "Destino (host:puerto)"

msgid ""
"E.g. 192.168.1.50:8080 · or container-name:3000 if it is on Caddy's network"
msgstr ""
"Ej.: 192.168.1.50:8080 · o nombre-contenedor:3000 si está en la red de Caddy"

msgid "Upstream uses HTTPS"
msgstr "El destino usa HTTPS"

msgid "  …ignore its certificate"
msgstr "  …ignorar su certificado"

msgid "Only if the upstream uses a self-signed certificate (lowers security)"
msgstr ""
"Solo si el destino usa un certificado autofirmado (reduce la seguridad)"

msgid "Gzip compression"
msgstr "Compresión gzip"

msgid "Security headers"
msgstr "Cabeceras de seguridad"

msgid "Access log (monitor)"
msgstr "Registrar accesos (monitor)"

msgid "Needed to see this service in the traffic monitor"
msgstr "Necesario para ver este servicio en el monitor de tráfico"

msgid "User (basic auth)"
msgstr "Usuario (autenticación básica)"

msgid "Optional: leave user and password empty for no login"
msgstr "Opcional: deja usuario y contraseña vacíos para no pedir login"

msgid "Password"
msgstr "Contraseña"

msgid "Leave empty to keep the current password"
msgstr "Déjala vacía para conservar la contraseña actual"

msgid "Stored hashed (bcrypt) in the Caddyfile"
msgstr "Se guarda cifrada (bcrypt) en el Caddyfile"

msgid "Invalid domain"
msgstr "Dominio no válido"

msgid "A block for that domain already exists in the Caddyfile"
msgstr "Ya existe un bloque para ese dominio en el Caddyfile"

msgid "Enter the upstream, e.g. 192.168.1.50:8080"
msgstr "Indica el destino, p. ej. 192.168.1.50:8080"

msgid "Enter user and password, or leave both empty"
msgstr "Indica usuario y contraseña, o deja ambos vacíos"

msgid "The user cannot contain spaces"
msgstr "El usuario no puede contener espacios"

msgid "There are no site blocks in the Caddyfile yet. Use [a] to add one."
msgstr "Todavía no hay sitios en el Caddyfile. Usa [a] para añadir uno."

msgid "Choose a service"
msgstr "Elige un servicio"

msgid "Edit with the form"
msgstr "Editar con el formulario"

msgid "Edit in the editor"
msgstr "Editar en el editor"

msgid "Remove"
msgstr "Eliminar"

msgid "Cancel"
msgstr "Cancelar"

#, python-brace-format
msgid "What do you want to do with {host}?"
msgstr "¿Qué quieres hacer con {host}?"

msgid "Block that will be removed"
msgstr "Bloque que se eliminará"

#, python-brace-format
msgid "Remove service {host}? The block will be deleted from the Caddyfile."
msgstr "¿Eliminar el servicio {host}? El bloque se borrará del Caddyfile."

msgid "Cancelled. Nothing was changed."
msgstr "Cancelado. No se ha modificado nada."

#, python-brace-format
msgid "Service {host} removed (previous copy: {path})."
msgstr "Servicio {host} eliminado (copia anterior: {path})."

msgid "Edit service"
msgstr "Editar servicio"

msgid "Generating configuration..."
msgstr "Generando configuración..."

msgid "Could not hash the password (is Docker available?)."
msgstr "No se pudo cifrar la contraseña (¿Docker disponible?)."

msgid "Block preview"
msgstr "Vista previa del bloque"

msgid "Save to the Caddyfile?"
msgstr "¿Guardar en el Caddyfile?"

#, python-brace-format
msgid "Service {host} updated (previous copy: {path})."
msgstr "Servicio {host} actualizado (copia anterior: {path})."

msgid "Add service to Caddy"
msgstr "Añadir servicio a Caddy"

msgid "Add service"
msgstr "Añadir servicio"

msgid "Add service: ERROR"
msgstr "Añadir servicio: ERROR"

msgid "The generated configuration is NOT valid"
msgstr "La configuración generada NO es válida"

msgid "Block preview (will be appended to the end of the Caddyfile)"
msgstr "Vista previa del bloque (se añadirá al final del Caddyfile)"

#, python-brace-format
msgid ""
"Service {host} added (previous copy: {path}).\n"
"Remember: the domain's DNS must point to this server and, if the upstream is "
"another\n"
"container, it must be on the same Docker network as Caddy."
msgstr ""
"Servicio {host} añadido (copia anterior: {path}).\n"
