msgstr "Indica el destino, p. ej. 192.168.1.50:8080"

msgid "Enter user and password, or leave both empty"
msgstr "Indica usuario y contraseña, o deja ambos vacíos"

msgid "The user cannot contain spaces"
msgstr "El usuario no puede contener espacios"

msgid "Add service to Caddy"
msgstr "Añadir servicio a Caddy"

msgid "Add service"
msgstr "Añadir servicio"

msgid "Cancelled. Nothing was changed."
msgstr "Cancelado. No se ha modificado nada."

msgid "Generating configuration..."
msgstr "Generando configuración..."

msgid "Add service: ERROR"
msgstr "Añadir servicio: ERROR"

msgid "Could not hash the password (is Docker available?)."
msgstr "No se pudo cifrar la contraseña (¿Docker disponible?)."

msgid "The generated configuration is NOT valid"
msgstr "La configuración generada NO es válida"

msgid "Block preview (will be appended to the end of the Caddyfile)"
msgstr "Vista previa del bloque (se añadirá al final del Caddyfile)"

msgid "Save to the Caddyfile?"
msgstr "¿Guardar en el Caddyfile?"

#, python-brace-format
msgid ""
"Service {host} added (previous copy: {path}).\n"
"Remember: the domain's DNS must point to this server and, if the upstream is "
"another\n"
"container, it must be on the same Docker network as Caddy."
msgstr ""
"Servicio {host} añadido (copia anterior: {path}).\n"
"Recuerda: el DNS del dominio debe apuntar a este servidor y, si el destino "
"es otro\n"
"contenedor, debe estar en la misma red Docker que Caddy."

msgid "The Caddy container is not running. Use [s] to start it."
msgstr "El contenedor de Caddy no está en marcha. Usa [s] para arrancarlo."

msgid "Monitor closed."
msgstr "Monitor cerrado."

msgid "Terminal too small (min. 60x14)"
msgstr "Terminal demasiado pequeña (mín. 60x14)"

#, python-brace-format
msgid " Traffic monitor · {name} · window {label}"
msgstr " Monitor de tráfico · {name} · ventana {label}"

msgid "  [PAUSED]"
msgstr "  [EN PAUSA]"

#, python-brace-format
msgid ""
"Requests: {n}  ({rate:.2f}/s)    Traffic sent: {size}    Avg latency: "
"{ms:.0f} ms"
msgstr ""
"Peticiones: {n}  ({rate:.2f}/s)    Tráfico enviado: {size}    Latencia "
"media: {ms:.0f} ms"

msgid "now"
msgstr "ahora"

msgid "Top domains"
msgstr "Top dominios"

msgid "Top client IPs"
msgstr "Top IPs de cliente"

msgid " Latest requests "
msgstr " Últimas peticiones "

msgid "No requests recorded yet."
msgstr "Sin peticiones registradas todavía."

msgid ""
"Accesses are only recorded if the site has the `log` directive in the "
"Caddyfile"
msgstr ""
"Los accesos solo se registran si el sitio tiene la directiva `log` en el "
"Caddyfile"

msgid "(services created with the wizard [a] include it by default)."
msgstr "(los servicios creados con el asistente [a] la incluyen por defecto)."

msgid "[p] pause · [w] window · [c] clear · [q] back"
msgstr "[p] pausa · [w] ventana · [c] limpiar · [q] volver"

msgid "Log stream closed (container stopped?)"
msgstr "Se cerró el flujo de logs (¿contenedor parado?)"

msgid "Docker is not responding"
msgstr "Docker no responde"

msgid ""
"Fix: start Docker (systemctl start docker) and check that your user can use "
"it."
msgstr ""
"Solución: arranca Docker (systemctl start docker) y comprueba que tu usuario "
"puede usarlo."

#, python-brace-format
msgid "Docker available (v{version})"
msgstr "Docker disponible (v{version})"

#, python-brace-format
msgid ""
"Variable {name} in the Caddyfile is not defined (neither in the container "
"nor in .env)"
msgstr ""
"La variable {name} del Caddyfile no está definida (ni en el contenedor ni "
"en .env)"

#, python-brace-format
msgid "Fix: define {name}=... in .env with [n] and apply it with [s]."
msgstr "Solución: define {name}=... en .env con [n] y aplícalo con [s]."

#, python-brace-format
msgid "Caddyfile variables defined ({names})"
msgstr "Variables del Caddyfile definidas ({names})"

msgid "The Caddyfile is valid"
msgstr "El Caddyfile es válido"

msgid ""
"Fix: edit it with [e] (the TUI will not let you save something invalid)."
msgstr "Solución: edítalo con [e] (la TUI no te dejará guardar algo inválido)."

msgid ""
"Fix: 'import name' needs a snippet '(name) { ... }' defined at the top of "
"the Caddyfile, or a file with that name next to it."
msgstr ""
"Solución: 'import nombre' necesita un snippet '(nombre) { ... }' definido al "
"principio del Caddyfile, o un fichero con ese nombre junto a él."

msgid "The Caddyfile is NOT valid"
msgstr "El Caddyfile NO es válido"

#, python-brace-format
msgid "Container {name} is not running (state: {state})"
msgstr "El contenedor {name} no está en marcha (estado: {state})"

msgid "Fix: start it (offered below) or with [s]."
msgstr "Solución: arrancarlo (se ofrece abajo) o con [s]."

#, python-brace-format
msgid "Container {name} is running"
msgstr "Contenedor {name} en marcha"

msgid "The container uses a DIFFERENT Caddyfile than the one on disk"
msgstr "El contenedor usa un Caddyfile DISTINTO al del disco"

msgid ""
"Typical cause: an editor replaced the file and Docker still mounts the old "
"one."
msgstr ""
"Causa típica: un editor sustituyó el fichero y Docker sigue montando el "
"antiguo."

msgid ""
"Fix: recreate the container (offered below). Until then your changes are not "
"applied!"
msgstr ""
"Solución: recrear el contenedor (se ofrece abajo). ¡Hasta entonces los "
"cambios no se aplican!"

msgid "The container sees the same Caddyfile as the disk"
msgstr "El contenedor ve el mismo Caddyfile que el disco"

#, python-brace-format
msgid "Caddyfile ports not published by the container: {ports}"
msgstr "Puertos del Caddyfile sin publicar en el contenedor: {ports}"

msgid "Those sites will not be reachable from outside."
msgstr "Desde fuera no se podrá acceder a esos sitios."

#, python-brace-format
msgid ""
"Fix: add them to 'ports' of service '{service}' in the docker compose "
"(offered below)."
msgstr ""
"Solución: añadirlos a 'ports' del servicio '{service}' en el docker compose "
"(se ofrece abajo)."

#, python-brace-format
msgid "Site ports published ({ports})"
msgstr "Puertos de los sitios publicados ({ports})"

#, python-brace-format
msgid "Ports {ports} not published"
msgstr "Puertos {ports} sin publicar"

msgid ""
"They are needed for Let's Encrypt to issue certificates (HTTP-01 challenge) "
"and for the HTTP→HTTPS redirect."
msgstr ""
"Hacen falta para que Let's Encrypt emita certificados (reto HTTP-01) y para "
"la redirección HTTP→HTTPS."

msgid ""
"Ignore this if you use your own certificates, DNS-01 or only a local network."
msgstr "Ignóralo si usas certificados propios, DNS-01 o solo red local."

#, python-brace-format
msgid "Upstream {host}:{port} responds"
msgstr "El destino {host}:{port} responde"

msgid "host.docker.internal is not configured in the container"
msgstr "host.docker.internal no está configurado en el contenedor"

msgid ""
"Fix: add extra_hosts 'host.docker.internal:host-gateway' (offered below)."
msgstr ""
"Solución: añadir extra_hosts 'host.docker.internal:host-gateway' (se ofrece "
"abajo)."

#, python-brace-format
msgid "Fix: connect Caddy to the network of '{host}'."
msgstr "Solución: conectar Caddy a la red de '{host}'."

#, python-brace-format
msgid "'{host}' is on Docker network: {nets}"
msgstr "'{host}' está en la red Docker: {nets}"

#, python-brace-format
msgid ""
"Fix: add that network to '{service}' as external in the docker compose "
"(offered below)."
msgstr ""
"Solución: añadir esa red a '{service}' como externa en el docker compose (se "
"ofrece abajo)."

msgid "I found no running container with that name: is it stopped?"
msgstr ""
"No he encontrado ningún contenedor en marcha con ese nombre: ¿está parado?"

#, python-brace-format
msgid "Caddy cannot resolve upstream '{host}' (different network)"
msgstr "Caddy no resuelve el destino '{host}' (red distinta)"

#, python-brace-format
msgid "{host}:{port} refuses the connection"
msgstr "{host}:{port} rechaza la conexión"

msgid "The service is not listening: is it stopped, or on another port?"
msgstr "El servicio no está escuchando: ¿está parado o es otro puerto?"

#, python-brace-format
msgid "{host}:{port} does not respond (timeout)"
msgstr "{host}:{port} no responde (timeout)"

msgid "Check that the service is running and the firewall."
msgstr "Revisa que el servicio esté arrancado y el cortafuegos."

#, python-brace-format
msgid "{count} errors in the logs of the last 10 min"
msgstr "{count} errores en los logs de los últimos 10 min"

msgid "No errors in the logs of the last 10 min"
msgstr "Sin errores en los logs de los últimos 10 min"

msgid "Running checks (may take a few seconds)..."
msgstr "Ejecutando comprobaciones (puede tardar unos segundos)..."

#, python-brace-format
msgid "Result: {problems} problem(s), {warns} warning(s)."
msgstr "Resultado: {problems} problema(s), {warns} aviso(s)."

msgid "All good."
msgstr "Todo correcto."

msgid "Diagnostics"
msgstr "Diagnóstico"

msgid "Start the Caddy container?"
msgstr "¿Arrancar el contenedor de Caddy?"

msgid "Required docker compose changes"
msgstr "Cambios necesarios en docker compose"

msgid ""
"The container was not created with docker compose (or I cannot find its "
"file; use --compose).\n"
"Apply these changes by hand and recreate the container:"
msgstr ""
"El contenedor no se creó con docker compose (o no encuentro su fichero; usa "
"--compose).\n"
"Aplica a mano estos cambios y recrea el contenedor:"

#, python-brace-format
msgid "Update {file} with the required changes?"
msgstr "¿Actualizar {file} con los cambios necesarios?"

msgid "The resulting compose file is not valid:"
msgstr "El compose resultante no es válido:"

msgid "Compose updated"
msgstr "Compose actualizado"

#, python-brace-format
msgid "{file} updated (backup: {path})."
msgstr "{file} actualizado (copia: {path})."

msgid "Could not update the compose file automatically"
msgstr "No se pudo actualizar el compose automáticamente"

#, python-brace-format
msgid "Add this by hand in {file}:"
msgstr "Añade a mano esto en {file}:"

msgid "Recreate the Caddy container to apply the changes?"
msgstr "¿Recrear el contenedor de Caddy para aplicar los cambios?"

msgid "Recreate"
msgstr "Recrear"

msgid "Run the diagnostics again?"
msgstr "¿Volver a ejecutar el diagnóstico?"

msgid "No .env exists. Create it from .env.example?"
msgstr "No existe .env. ¿Crearlo desde .env.example?"

msgid "No .env exists. Create an empty one?"
msgstr "No existe .env. ¿Crearlo vacío?"

msgid ""
"If you changed variables the container uses, use [s] to recreate it with "
"them."
msgstr ""
"Si has cambiado variables que usa el contenedor, usa [s] para recrearlo con "
"ellas."

msgid "Language"
msgstr "Idioma"

#, python-brace-format
msgid "Interface language: {lang}"
msgstr "Idioma de la interfaz: {lang}"

msgid "Stop Caddy? The site will stop being served over HTTPS."
msgstr "¿Parar Caddy? El sitio dejará de servirse por HTTPS."

msgid "Restart Caddy? There will be a brief outage."
msgstr "¿Reiniciar Caddy? Habrá un corte breve."

msgid "Error"
msgstr "Error"

msgid "TUI to manage a Caddy running in Docker."
msgstr "TUI para gestionar un Caddy en Docker."

msgid "name of the Caddy container"
msgstr "nombre del contenedor de Caddy"

msgid "path of the Caddyfile on the host"
msgstr "ruta del Caddyfile en el host"

msgid "project folder (compose, .env, backups)"
msgstr "carpeta del proyecto (compose, .env, backups)"

msgid "docker compose file"
msgstr "fichero docker compose"

msgid "Caddy service in the compose file"
msgstr "servicio de Caddy en el compose"

msgid "image used to validate/format"
msgstr "imagen para validar/formatear"

#, python-brace-format
msgid ""
"interface language: auto or one of {langs} (default: saved preference, else "
"system language)"
msgstr ""
"idioma de la interfaz: auto o uno de {langs} (por defecto: el guardado, si "
"no el del sistema)"

msgid "Docker is not installed or not in PATH."
msgstr "Docker no está instalado o no está en el PATH."

msgid "This program needs an interactive terminal."
msgstr "Este programa necesita un terminal interactivo."

msgid "HTTPS certificates"
msgstr "Certificados HTTPS"

msgid "Reading certificates..."
msgstr "Leyendo certificados..."

msgid "Could not read the certificate storage of the container."
msgstr "No se pudo leer el almacén de certificados del contenedor."

msgid "{names} · internal CA (local, renewed automatically)"
msgstr "{names} · CA interna (local, se renueva sola)"

msgid "Caddy renews about 30 days before expiry. If it has not, check the ACME errors below or the logs [g]."
msgstr "Caddy renueva unos 30 días antes de que caduque. Si no lo ha hecho, revisa los errores ACME de abajo o los logs [g]."

msgid "{names} · {issuer} · EXPIRED on {date}"
msgstr "{names} · {issuer} · CADUCADO el {date}"

msgid "{names} · {issuer} · about to expire: {date} ({days} days left)"
msgstr "{names} · {issuer} · a punto de caducar: {date} (quedan {days} días)"

msgid "{names} · {issuer} · renewal pending: valid until {date} ({days} days left)"
msgstr "{names} · {issuer} · renovación pendiente: válido hasta {date} (quedan {days} días)"

msgid "{names} · {issuer} · valid until {date} ({days} days left)"
msgstr "{names} · {issuer} · válido hasta {date} (quedan {days} días)"

msgid "Let's Encrypt/ACME is failing for {domain}"
msgstr "Let's Encrypt/ACME está fallando para {domain}"

msgid "Typical causes: DNS not pointing here, ports 80/443 closed, or rate limits (wait an hour)."
msgstr "Causas típicas: el DNS no apunta aquí, puertos 80/443 cerrados o límites de frecuencia (espera una hora)."

msgid "No certificate yet for {domain}"
msgstr "Aún no hay certificado para {domain}"

msgid "Caddy requests it on the first HTTPS request. Check that the DNS points to this server and that ports 80 and 443 are reachable from the Internet."
msgstr "Caddy lo solicita en la primera petición HTTPS. Comprueba que el DNS apunta a este servidor y que los puertos 80 y 443 son accesibles desde Internet."

msgid "No certificates stored yet"
msgstr "Todavía no hay certificados guardados"

msgid "HTTPS certificates valid ({n})"
msgstr "Certificados HTTPS válidos ({n})"
